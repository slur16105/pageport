# 이 파일은 외부 서비스 연결에 필요한 값의 이름을 보여주는 견본입니다. 실제 비밀값은 절대 GitHub에 올리지 않습니다.

# Supabase 데이터베이스: 앱은 6543 연결을, 구조 변경 작업은 5432 연결을 사용합니다.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres

# Supabase API와 PDF 파일 저장소 연결 정보
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# 구매·인증 이메일을 보내는 Resend 연결 정보
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=PAGEPORT <hello@your-domain.example>

# 관리자 인증과 다운로드 주소 보호용 비밀문자입니다. 세 항목은 서로 다른 긴 무작위 값으로 만듭니다.
ADMIN_EMAIL=owner@example.com
EMAIL_VERIFICATION_SECRET=replace_with_at_least_24_random_characters
DOWNLOAD_LINK_SECRET=replace_with_at_least_24_random_characters
ADMIN_SESSION_SECRET=replace_with_at_least_24_random_characters

# 토스페이먼츠 시험 결제용 키입니다. 정식 오픈 전까지 실제 결제키를 넣지 않습니다.
NEXT_PUBLIC_TOSS_TEST_CLIENT_KEY=test_gck_replace_me
TOSS_TEST_SECRET_KEY=test_gsk_replace_me
TOSS_WEBHOOK_SECRET=replace_with_at_least_24_random_characters

# 매일 실패한 이메일과 만료 자료를 정리하는 자동 작업의 출입 비밀번호입니다.
CRON_SECRET=replace_with_at_least_24_random_characters

# 아래 서비스는 선택사항이며, 해당 서비스를 가입·연결하기 전에는 빈칸으로 두어도 됩니다.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GA_ID=
ENABLE_ANALYTICS=false
