# Resend 대시보드에서 발급받는 비밀키입니다. 외부에 공개하지 마세요.
RESEND_API_KEY=re_your_api_key

# 24자 이상의 무작위 문자열을 사용합니다. 인증번호와 확인표를 안전하게 보호합니다.
EMAIL_VERIFICATION_SECRET=replace_with_a_long_random_secret

# 도메인 인증 전에는 가입자 본인 이메일로만 시험 발송할 수 있습니다.
RESEND_FROM_EMAIL=PAGEPORT <onboarding@resend.dev>

# 24시간 다운로드 주소를 위조할 수 없도록 보호합니다.
DOWNLOAD_LINK_SECRET=replace_with_a_long_random_secret

# 관리자 화면에 로그인할 수 있는 유일한 이메일입니다.
ADMIN_EMAIL=owner@example.com

# 24자 이상의 무작위 문자열로 관리자 로그인 상태를 보호합니다.
ADMIN_SESSION_SECRET=replace_with_a_long_random_secret
