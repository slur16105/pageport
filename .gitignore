# GitHub에 올리면 안 되거나 다시 만들 수 있는 파일을 지정합니다.

# 설치한 외부 기술 파일
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 자동검사가 만든 결과물
/coverage
/test-results/
/playwright-report/
/tsconfig.tsbuildinfo
/.pnpm-store/

# Next.js가 빌드하면서 자동 생성한 폴더
/.next/
/.vinext/
/out/

# 운영체제와 인증서 관련 임시 파일
.DS_Store
*.pem

# 오류 확인 과정에서 생성되는 기록 파일
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 비밀키가 든 환경설정은 제외하고, 빈칸 견본인 .env.example만 공유합니다.
.env*
!.env.example
.dev.vars*
!.dev.vars.example

# Vercel이 내 컴퓨터에 만든 연결 정보
.vercel

/dist/
/.wrangler/
/outputs/
/work/
