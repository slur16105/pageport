generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  category    String
  title       String
  sellerName  String   @map("seller_name")
  description String
  amount      Int
  accent      String   @default("mint")
  mark        String
  pages       Int
  fileSize    String   @map("file_size")
  summary     String
  includes    String[] @default([])
  status      String   @default("draft")
  objectKey   String   @map("object_key")
  previewKeys String[] @default([]) @map("preview_keys")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  orders      Order[]

  @@index([status, updatedAt])
  @@map("products")
}

model Order {
  id                 String          @id
  productId          String          @db.Uuid @map("product_id")
  productSlug        String          @map("product_slug")
  productTitle       String          @map("product_title")
  sellerName         String          @map("seller_name")
  buyerEmail         String          @map("buyer_email")
  amount             Int
  currency           String          @default("KRW")
  status             String          @default("pending")
  isTest             Boolean         @default(true) @map("is_test")
  emailVerifiedAt    DateTime         @map("email_verified_at")
  paymentKey         String?          @unique @map("payment_key")
  approvedAt         DateTime?        @map("approved_at")
  receiptEmailSentAt DateTime?        @map("receipt_email_sent_at")
  receiptEmailId     String?          @map("receipt_email_id")
  totalDownloadCount Int              @default(0) @map("total_download_count")
  refundedAt         DateTime?        @map("refunded_at")
  refundReason       String?          @map("refund_reason")
  refundEmailSentAt  DateTime?        @map("refund_email_sent_at")
  refundEmailId      String?          @map("refund_email_id")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  product            Product          @relation(fields: [productId], references: [id])
  downloadGrants     DownloadGrant[]
  downloadEvents     DownloadEvent[]

  @@index([buyerEmail, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model EmailVerification {
  id                    String    @id @default(uuid()) @db.Uuid
  email                 String
  purpose               String
  codeHash              String    @map("code_hash")
  verificationTokenHash String?   @map("verification_token_hash")
  expiresAt             DateTime  @map("expires_at")
  lastSentAt            DateTime  @map("last_sent_at")
  attempts              Int       @default(0)
  verifiedAt            DateTime? @map("verified_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([email, purpose])
  @@index([expiresAt])
  @@map("email_verifications")
}

model DownloadGrant {
  id             String          @id @default(uuid()) @db.Uuid
  orderId        String          @map("order_id")
  tokenHash      String          @unique @map("token_hash")
  objectKey      String          @map("object_key")
  expiresAt      DateTime        @map("expires_at")
  downloadCount  Int             @default(0) @map("download_count")
  maxDownloads   Int             @default(5) @map("max_downloads")
  revokedAt      DateTime?       @map("revoked_at")
  lastDownloadedAt DateTime?     @map("last_downloaded_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events         DownloadEvent[]

  @@index([orderId, createdAt])
  @@index([expiresAt])
  @@map("download_grants")
}

model DownloadEvent {
  id          String        @id @default(uuid()) @db.Uuid
  orderId     String        @map("order_id")
  grantId     String        @db.Uuid @map("grant_id")
  ipHash      String?       @map("ip_hash")
  userAgent   String?       @map("user_agent")
  createdAt   DateTime      @default(now()) @map("created_at")
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  grant       DownloadGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("download_events")
}

model WebhookEvent {
  id          String    @id
  eventType   String    @map("event_type")
  paymentKey  String?   @map("payment_key")
  payload     Json
  status      String    @default("received")
  processedAt DateTime? @map("processed_at")
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("webhook_events")
}

model JobLedger {
  id          String    @id @default(uuid()) @db.Uuid
  jobKey      String    @unique @map("job_key")
  jobType     String    @map("job_type")
  payload     Json
  status      String    @default("pending")
  attempts    Int       @default(0)
  nextRunAt   DateTime  @default(now()) @map("next_run_at")
  lockedAt    DateTime? @map("locked_at")
  completedAt DateTime? @map("completed_at")
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status, nextRunAt])
  @@map("job_ledger")
}

model RequestLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @map("window_start")
  expiresAt   DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("request_limits")
}

model UploadTicket {
  id        String   @id @default(uuid()) @db.Uuid
  objectKey String   @unique @map("object_key")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("upload_tickets")
}
